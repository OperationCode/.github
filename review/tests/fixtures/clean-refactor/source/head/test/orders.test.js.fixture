"use strict";

const assert = require("node:assert");
const { isoDay, orderLine, refundLine } = require("../src/orders");

assert.strictEqual(isoDay("2026-01-09T00:00:00Z"), "2026-01-09");
assert.strictEqual(orderLine({ id: "o1", createdAt: "2026-03-04T10:00:00Z", total: 12.5 }), "o1 2026-03-04 12.50");
assert.strictEqual(refundLine({ id: "r1", createdAt: "2026-03-05T23:59:00Z", amount: 3 }), "r1 2026-03-05 -3.00");
