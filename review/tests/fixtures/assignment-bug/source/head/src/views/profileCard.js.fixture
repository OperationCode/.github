"use strict";

function badgeFor(user) {
  if (user.role = "admin") {
    return "Administrator";
  }
  return "Member";
}

// Display data for a profile card. `profile` is a plain object copied from
// the API response; it is only read here.
function profileCard(profile) {
  return {
    name: profile.displayName,
    joined: profile.joinedYear,
    badge: badgeFor(profile),
  };
}

module.exports = { badgeFor, profileCard };
